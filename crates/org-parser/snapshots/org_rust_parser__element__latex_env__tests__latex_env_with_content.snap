---
source: crates/org-parser/src/element/latex_env.rs
description: |
  
  \begin{align*}
  
  \text{latex constructs}\\
  \alpha\\
  \beta\\
  
  10x + 4 &= 3\\
  
  \end{align*}
---
0..90 [1, 2, 4, 5]
  0..1 BlankLine
  1..16 Paragraph([3])
    1..15 Command { name: "begin", contents: Some("align*") }
  16..17 BlankLine
  17..90 Paragraph([6, 7, 8, 9, 10, 11, 12, 14, 13, 15, 16])
    17..40 Command { name: "text", contents: Some("latex constructs") }
    40..43 LineBreak
    43..49 Entity { name: "alpha", mapped_item: "α" }
    49..52 LineBreak
    52..57 Entity { name: "beta", mapped_item: "β" }
    57..60 LineBreak
    60..61 SoftBreak
    61..73 "10x + 4 &= 3"
    73..76 LineBreak
    76..77 SoftBreak
    77..89 Command { name: "end", contents: Some("align*") }
