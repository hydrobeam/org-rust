---
0..55 [1, 2, 3]
  0..30 MacroDef { num_args: 2, input: [Text("hiii "), ArgNum(1), Text(" "), ArgNum(2), Text(" text")], name: "poem" }
  30..31 BlankLine
  31..55 Paragraph([4])
    31..54 MacroCall { name: "poem", args: ["cool", " three"] }
macros:
